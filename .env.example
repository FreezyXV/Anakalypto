# Chaine de connexion PostgreSQL utilisee par l'application et par Prisma.
# En production: chaine "poolee" du projet Neon (pooler -pooler.<region>.aws.neon.tech).
DATABASE_URL="postgresql://utilisateur:motdepasse@hote/base?sslmode=require"

# Optionnel. Connexion directe (sans pooler) utilisee pour les migrations Prisma.
# Renseigner uniquement si le fournisseur expose une URL directe distincte.
DIRECT_URL="postgresql://utilisateur:motdepasse@hote-direct/base?sslmode=require"

# URL publique canonique du site, sans barre oblique finale.
# Sert aux metadonnees, au sitemap, a robots.txt et aux URL canoniques.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
