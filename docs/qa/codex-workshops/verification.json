      "scroll": 320,
      "width": 320,
      "workshop": true
    },
    {
      "slug": "les-quatre-temps",
      "caption": "Combustion-détente : les soupapes restent fermées. Les gaz chauds poussent le piston vers le bas.",
      "minTextPx": 12.22202380952381,
